{
  "scopeName": "text.atwiki",
  "patterns": [
    { "name": "comment.line.double-slash.atwiki", "match": "^//.*$" },
    { "name": "markup.heading.atwiki", "match": "^\\*{1,5}.*$" },
    { "name": "markup.raw.block.atwiki", "match": "^ .*$" },
    { "name": "markup.underline.link.atwiki", "match": "\\[\\[.*?\\]\\]" },
    { "name": "entity.name.function.atwiki", "match": "[&#][a-zA-Z_][a-zA-Z_0-9]*(?:\\([^\\n)]*\\))?" },
    { "name": "markup.italic.atwiki", "match": "'''[^\\n]+?'''" },
    { "name": "markup.bold.atwiki", "match": "''[^\\n]+?''" },
    { "name": "markup.strikethrough.atwiki", "match": "%%[^\\n]+?%%" },
    { "name": "punctuation.definition.list.atwiki", "match": "^[-+]{1,3}|^>+|\\||^-{4,}$" }
  ]
}
