{
  "name": "atwiki-local-preview",
  "displayName": "Atwiki Editor",
  "description": "アットウィキ記法をオフラインで編集・ライブプレビューする拡張機能",
  "version": "1.0.1",
  "publisher": "atwiki-local-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakoniwa0430/atwiki-editor.git"
  },
  "homepage": "https://github.com/hakoniwa0430/atwiki-editor#readme",
  "bugs": {
    "url": "https://github.com/hakoniwa0430/atwiki-editor/issues"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "atwiki",
    "wiki",
    "preview",
    "アットウィキ"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "atwiki",
        "aliases": [
          "アットウィキ",
          "AtWiki"
        ],
        "extensions": [
          ".atwiki",
          ".atw"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/atwiki-light.svg",
          "dark": "./media/icons/atwiki-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "atwiki",
        "scopeName": "text.atwiki",
        "path": "./syntaxes/atwiki.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "atwiki",
        "path": "./snippets/atwiki.json"
      }
    ],
    "commands": [
      {
        "command": "atwiki.convertImagesToWebpOnly",
        "title": "アットウィキ: 画像をWebPに変換する"
      },
      {
        "command": "atwiki.convertImagesToWebp",
        "title": "アットウィキ: 画像をWebPに変換して参照を更新"
      },
      {
        "command": "atwiki.autoLinkPageNames",
        "title": "アットウィキ: ページ名の自動リンクを実行（現在の本文）",
        "icon": "$(link)"
      },
      {
        "command": "atwiki.openPreview",
        "title": "アットウィキ: プレビューを横に開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "atwiki.connectWiki",
        "title": "アットウィキ: Wikiに接続（OAuth）"
      },
      {
        "command": "atwiki.disconnectWiki",
        "title": "アットウィキ: Wikiとの接続を解除"
      },
      {
        "command": "atwiki.downloadWikiPage",
        "title": "アットウィキ: Wikiの全ページを取得・同期"
      },
      {
        "command": "atwiki.compareWikiPage",
        "title": "アットウィキ: Wikiの最新更新と比較",
        "icon": "$(diff)"
      },
      {
        "command": "atwiki.pullWikiPage",
        "title": "アットウィキ: Wikiの全ページを同期"
      },
      {
        "command": "atwiki.pullCurrentWikiPage",
        "title": "アットウィキ: 現在のページだけ同期"
      },
      {
        "command": "atwiki.resolveWikiConflict",
        "title": "アットウィキ: 競合解決済みとして同期基準を更新"
      },
      {
        "command": "atwiki.publishWikiPage",
        "title": "アットウィキ: 差分を確認して本家へ投稿"
      },
      {
        "command": "atwiki.updateWikiPage",
        "title": "アットウィキ: Wikiを更新（1ファイルを指定）",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "atwiki.createWikiPage",
        "title": "アットウィキ: ページを追加"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "atwiki.openPreview",
          "when": "editorLangId == atwiki",
          "group": "navigation@0"
        },
        {
          "command": "atwiki.compareWikiPage",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "atwiki.updateWikiPage",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "atwiki.convertImagesToWebpOnly",
          "when": "editorLangId == atwiki && resourceScheme == file",
          "group": "atwikiImages"
        },
        {
          "command": "atwiki.convertImagesToWebp",
          "when": "editorLangId == atwiki && resourceScheme == file",
          "group": "atwikiImages"
        },
        {
          "command": "atwiki.autoLinkPageNames",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file",
          "group": "atwikiLinks"
        },
        {
          "command": "atwiki.openPreview",
          "when": "editorLangId == atwiki || editorLangId == plaintext",
          "group": "navigation"
        },
        {
          "command": "atwiki.compareWikiPage",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "atwikiSync"
        },
        {
          "command": "atwiki.pullWikiPage",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "atwikiSync"
        },
        {
          "command": "atwiki.resolveWikiConflict",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "atwikiSync"
        },
        {
          "command": "atwiki.publishWikiPage",
          "when": "(editorLangId == atwiki || editorLangId == plaintext) && resourceScheme == file && isWorkspaceTrusted",
          "group": "atwikiSync"
        }
      ],
      "explorer/context": [
        {
          "command": "atwiki.updateWikiPage",
          "when": "resourceScheme == file && !explorerResourceIsFolder && (resourceExtname == .atwiki || resourceExtname == .atw || resourceExtname == .txt) && isWorkspaceTrusted",
          "group": "atwikiSync"
        }
      ]
    },
    "keybindings": [
      {
        "command": "atwiki.openPreview",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && editorLangId == atwiki"
      }
    ],
    "configuration": {
      "title": "Atwiki Editor",
      "properties": {
        "atwiki.webp.compression": {
          "type": "string",
          "enum": [
            "lossless",
            "lossy"
          ],
          "enumDescriptions": [
            "画質維持（可逆圧縮）",
            "容量優先（非可逆圧縮）"
          ],
          "default": "lossless",
          "description": "WebP変換の圧縮方式。画像サイズは変更しません。"
        },
        "atwiki.webp.quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "非可逆圧縮時の画質（1～100）。可逆圧縮時には適用しません。"
        },
        "atwiki.autoLink.excludedPages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "ページ名の自動リンクから除外するローカルページ名（拡張子なし）。初期ページや非公開ページなどを指定します。"
        },
        "atwiki.preview.wikiName": {
          "type": "string",
          "default": "ローカルWiki",
          "description": "wikiname に表示するウィキ名。"
        },
        "atwiki.preview.wikiUrl": {
          "type": "string",
          "default": "",
          "description": "wikiurl に表示するウィキのURL。"
        },
        "atwiki.preview.allowSharedImages": {
          "type": "boolean",
          "default": true,
          "description": "ウィキ内共通利用ファイル管理の画像URL（img.atwiki.jp の /pub/）をHTTPSで読み込みます。旧画像URLも対応します。"
        },
        "atwiki.preview.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "description": "HTTPS の外部画像全般を読み込みます。共通利用ファイルの画像は allowSharedImages でも個別に許可できます。"
        },
        "atwiki.preview.displayMode": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile"
          ],
          "default": "desktop",
          "description": "pc / mobile などの条件付き記法を確認するための表示モード。"
        },
        "atwiki.preview.theme": {
          "type": "string",
          "enum": [
            "uikit",
            "paper",
            "editor"
          ],
          "default": "uikit",
          "description": "uikit は Uikit レスポンシブに寄せた本文表示、paper は従来の用紙、editor は VS Code の配色です。"
        },
        "atwiki.preview.updateDelay": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 2000,
          "description": "入力から再描画までの待機時間（ミリ秒）。"
        },
        "atwiki.preview.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "エディターのスクロール位置をプレビューに反映します。"
        },
        "atwiki.preview.allowExternalEmbeds": {
          "type": "boolean",
          "default": false,
          "description": "YouTube・ニコニコ動画・X・Discordの埋め込みを取得します。表示すると外部サービスへ接続します。"
        },
        "atwiki.preview.allowExternalFeeds": {
          "type": "boolean",
          "default": false,
          "description": "公開HTTPSのRSS/Atomを取得します。最大4フィード・各512KB、60秒キャッシュ。HTTP指定はHTTPSへ変換します。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "audit": "node scripts/audit.js",
    "package": "node scripts/package.js",
    "format": "prettier --write \"src/**/*.js\" \"media/*.js\" \"media/interactions/*.js\" \"scripts/*.js\" \"test/*.test.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"media/*.js\" \"media/interactions/*.js\" \"scripts/*.js\" \"test/*.test.js\"",
    "audit:write": "node scripts/audit.js --write"
  },
  "icon": "media/icons/extension.png",
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "activationEvents": [
    "onUri"
  ]
}
